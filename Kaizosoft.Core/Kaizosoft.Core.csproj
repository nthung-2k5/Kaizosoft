        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>2.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="../keys.csv">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
